# Managed by edgekit — regenerated by `edgekit provision`.
services:
  npm:
    image: {{ image }}
    container_name: {{ container_name }}
    restart: unless-stopped

    ports:
      - "{{ http_port }}:80"
      - "{{ https_port }}:443"
      # Admin UI. Bound to {{ admin_bind }} so it is not reachable from the internet;
      # the edgekit panel proxies to it, or reach it over an SSH tunnel.
      - "{{ admin_bind }}:{{ admin_port }}:81"

    volumes:
      - ./data:/data
      - ./letsencrypt:/etc/letsencrypt

    environment:
      # Trust the tunnel and Docker networks for real-IP purposes.
      DISABLE_IPV6: "true"

    healthcheck:
      test: ["CMD", "/usr/bin/check-health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
